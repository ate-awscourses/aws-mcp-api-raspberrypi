      "name": "Health (Valid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\npm.test(\"Response indicates healthy status\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.status).to.eql(\"healthy\");\n});\n"
