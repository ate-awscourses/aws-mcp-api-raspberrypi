              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\npm.test(\"AWS Sync was successfully triggered\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.aws_sync).to.include(\"synced_to_dynamodb\");\n});\n"
